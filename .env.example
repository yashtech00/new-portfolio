# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Admin auth (/admin-1734)
ADMIN_PASSWORD=your-strong-password-here
ADMIN_SECRET=your-random-jwt-secret-min-32-chars

# Cloudflare R2 (file uploads)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Legacy Cloudinary (fallback during migration)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional — GitHub stats
GITHUB_TOKEN=
